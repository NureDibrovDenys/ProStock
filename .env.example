# ── База даних ─────────────────────────────────────────────────────────────
DB_NAME=prostock
DB_USER=prostock
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ── Безпека ────────────────────────────────────────────────────────────────
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false

# Час життя access-токена (хвилини) і refresh-токена (дні)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true — лише на HTTPS (production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Дозволені origin для прямого звертання до API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Обмеження спроб входу
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# ── Імпорт ─────────────────────────────────────────────────────────────────
IMPORT_MAX_FILE_MB=5
IMPORT_MAX_ROWS=5000

# ── Стартові облікові записи ───────────────────────────────────────────────
# УВАГА: для production вимкніть після створення власних адміністраторів
SEED_DEFAULT_USERS=true
ADMIN_EMAIL=admin@prostock.com
ADMIN_PASSWORD=Admin12345
MANAGER_EMAIL=manager@prostock.com
MANAGER_PASSWORD=Manager12345
WORKER_EMAIL=worker@prostock.com
WORKER_PASSWORD=Worker12345

# ── Портал ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
