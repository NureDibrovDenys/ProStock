# Локальний запуск бекенда (копіюйте у backend/.env)

DB_NAME=prostock
DB_USER=prostock
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_DEFAULT_USERS=true
ADMIN_EMAIL=admin@prostock.com
ADMIN_PASSWORD=Admin12345
MANAGER_EMAIL=manager@prostock.com
MANAGER_PASSWORD=Manager12345
WORKER_EMAIL=worker@prostock.com
WORKER_PASSWORD=Worker12345
