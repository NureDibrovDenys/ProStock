# Склад, з яким працює веб-панель (поки що використовується лише сторінками складу)
VITE_WAREHOUSE_ID=1

# Вхід увімкнений за замовчуванням. false — лише для локальних експериментів без бекенда
VITE_AUTH_ENABLED=true

# Адреса бекенда для dev-проксі (за замовчуванням http://127.0.0.1:8000)
# VITE_API_TARGET=http://127.0.0.1:8000
